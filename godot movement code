extends CharacterBody3D

# --- CAMERA SENSITIVITY ---
# How fast the camera rotates when the mouse moves.
@export var MOUSE_SENSITIVITY = 0.002

# --- EXPORTED MOVEMENT VARIABLES ---
@export var SPEED = 8.0 
@export var JUMP_VELOCITY = 6.0 

# --- CONSTANTS ---
const JUMP_GRAVITY = 9.8 

# --- NODE REFERENCES ---
# These are still needed for camera control and visual feedback
@onready var spring_arm = $SpringArm3D 
@onready var visual_cube = $VisualCube


# ----------------------------------------------------------------------
# _ready() : Locks the mouse cursor
# ----------------------------------------------------------------------
func _ready():
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED


# ----------------------------------------------------------------------
# _input(event) : Mouse Look and Capture/Release
# ----------------------------------------------------------------------
func _input(event):
	# RELEASE/CAPTURE MOUSE: Pressing Escape (ui_cancel) releases the mouse
	if event.is_action_pressed("ui_cancel"): 
		if Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
			Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
		else:
			Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

	# MOUSE LOOK
	if event is InputEventMouseMotion and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
		# 1. Horizontal Rotation (Player turns, affecting movement direction)
		rotate_y(-event.relative.x * MOUSE_SENSITIVITY)
		
		# 2. Vertical Rotation (Camera only rotates up/down)
		spring_arm.rotate_x(-event.relative.y * MOUSE_SENSITIVITY)
		
		# Clamp the vertical rotation to prevent looking upside down
		var rot_x = spring_arm.rotation.x
		spring_arm.rotation.x = clamp(rot_x, deg_to_rad(-60), deg_to_rad(30))


# ----------------------------------------------------------------------
# _physics_process(delta) : Handles Movement, Gravity, and Jump
# ----------------------------------------------------------------------
func _physics_process(delta: float) -> void:
	
	# --- GRAVITY ---
	# Apply gravity only if the player is not touching the floor.
	if not is_on_floor():
		# NOTE: 'velocity' is a built-in property of CharacterBody3D
		velocity.y -= JUMP_GRAVITY * delta

	# --- JUMP INPUT ---
	# "ui_accept" is usually Spacebar/Enter
	if Input.is_action_just_pressed("ui_accept") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	# --- GET 3D MOVEMENT INPUT ---
	var input_dir = Input.get_vector("ui_left", "ui_right", "ui_up", "ui_down")
	
	# Convert local input (WASD) to global direction based on where the player is looking (transform.basis)
	var direction = (transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()

	# --- APPLY MOVEMENT VELOCITY ---
	if direction:
		# When moving, set X/Z velocity based on input direction and SPEED
		var new_velocity = direction * SPEED
		velocity.x = new_velocity.x
		velocity.z = new_velocity.z
		
	else:
		# Decelerate when no input is pressed (stops sliding)
		velocity.x = move_toward(velocity.x, 0, SPEED)
		velocity.z = move_toward(velocity.z, 0, SPEED)

	# --- EXECUTE MOVEMENT ---
	move_and_slide()
